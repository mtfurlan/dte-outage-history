#!/bin/bash
set -euo pipefail
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

sorted=$DIR/../raw_files/processed

file=${1:?must pass filename}
if [[ ! -f "$file" ]]; then
    echo "file not found $f"
    exit 1
fi
f=$(basename "$file")
date=${f/#outage-/}
date=${date/%.geojson.tgz/}
date=${date/%.svg/}
date=${date/%.png/}
if [[ -z "$date" ]]; then
    echo "unable to parse date from '$file'"
    exit 2
fi
dateDir=$(date -d "$date" +"%Y/%m/%d")

mkdir -p "$sorted/$dateDir"
mv "$file" "$sorted/$dateDir/$f"
